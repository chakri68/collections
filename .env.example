# Owner authentication (Phase 2). Copy to .env.local and set real values.
# Without these the server runs with a loud-warning dev fallback
# (password "let-me-in", an ephemeral per-process session secret).

# The single owner password. Anyone with this can write to the collection.
OWNER_PASSWORD=change-me

# HMAC secret for signing session cookies. Use a long random string:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-hex-string

# Public — Instagram handle (no @) the "Suggest something" box DMs. Optional;
# defaults to the value in lib/site-config.ts. Empty string hides the box.
NEXT_PUBLIC_INSTAGRAM_HANDLE=chakri.68
