# Owner authentication (Phase 2). Copy to .env.local and set real values.
# Without these the server runs with a loud-warning dev fallback
# (password "let-me-in", an ephemeral per-process session secret).

# The single owner password. Anyone with this can write to the collection.
OWNER_PASSWORD=change-me

# HMAC secret for signing session cookies. Use a long random string:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-hex-string

# Public — Instagram handle (no @) the "Suggest something" box DMs. Optional;
# defaults to the value in lib/site-config.ts. Empty string hides the box.
NEXT_PUBLIC_INSTAGRAM_HANDLE=chakri.68

# Public — canonical origin. Optional; defaults to lib/site-config.ts.
NEXT_PUBLIC_SITE_URL=https://lib.chakri.me

# Production write path. When BOTH are set, the write endpoint commits through
# the GitHub Contents API instead of the local repo — this is what a deployed
# host uses. The token is server-only and never reaches the browser.
#   GITHUB_TOKEN: a fine-grained PAT with Contents: read+write on just this repo.
#   GITHUB_REPO:  "owner/name" of the content repo.
#   GITHUB_BRANCH: optional, defaults to "main".
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=chakri68/collection
# GITHUB_BRANCH=main

# Runtime content sourcing. Set to "github" on the deployed host to read content
# from the repo at runtime (via GITHUB_REPO/BRANCH, using GITHUB_TOKEN for a
# private repo) instead of the files shipped with the build. A content-only
# commit then shows up without a rebuild — pair with the Vercel Ignored Build
# Step (scripts/vercel-ignore-build.js). Unset/"fs" reads the local content/ dir
# (the default; used in dev).
# CONTENT_SOURCE=github
# CONTENT_REVALIDATE=300   # seconds; fallback for content edited outside the app

# Secret for the on-demand revalidation webhook (app/api/revalidate). Point a
# GitHub push webhook (filtered to content/) here so direct-on-GitHub edits show
# up instantly. Unset = the endpoint is disabled.
# REVALIDATE_SECRET=change-me-to-a-random-string
